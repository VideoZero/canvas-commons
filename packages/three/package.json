{
  "name": "@canvas-commons/three",
  "version": "0.4.0",
  "description": "Three.js 3D scenes as Canvas Commons nodes, driven by signals",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "canvas-commons",
  "homepage": "https://canvascommons.io/",
  "bugs": "https://github.com/canvas-commons/canvas-commons/issues",
  "license": "MIT",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:pkg": "publint --strict && attw --pack . --profile esm-only --ignore-rules internal-resolution-error"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canvas-commons/canvas-commons.git",
    "directory": "packages/three"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "@canvas-commons/2d": "workspace:^",
    "@canvas-commons/core": "workspace:^"
  },
  "peerDependencies": {
    "@types/three": ">=0.160.0",
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "@types/three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "geometry-polyfill": "^1.0.7",
    "jsdom": "catalog:",
    "three": "^0.186.0",
    "vitest": "catalog:"
  }
}
