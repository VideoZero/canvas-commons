{
  "compilerOptions": {
    "outDir": "lib",
    "inlineSourceMap": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "module": "ESNext",
    "target": "ES2020",
    "declaration": true,
    "declarationMap": true,
    "experimentalDecorators": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@motion-canvas/2d/src",
    "strict": true
  },
  "include": ["src"]
}
