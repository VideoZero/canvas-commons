{
  "name": "@canvas-commons/shiki",
  "version": "0.4.0",
  "description": "A Shiki code highlighter for Canvas Commons",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "canvas-commons",
  "homepage": "https://canvascommons.io/",
  "bugs": "https://github.com/canvas-commons/canvas-commons/issues",
  "license": "MIT",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:pkg": "publint --strict && attw --pack . --profile esm-only --ignore-rules internal-resolution-error"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canvas-commons/canvas-commons.git",
    "directory": "packages/shiki"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "@canvas-commons/2d": "workspace:^",
    "@canvas-commons/core": "workspace:^",
    "@shikijs/core": "^3.23.0",
    "@shikijs/engine-javascript": "^3.23.0",
    "@shikijs/langs": "^3.23.0",
    "@shikijs/themes": "^3.23.0"
  },
  "devDependencies": {
    "jsdom": "catalog:",
    "vitest": "catalog:"
  }
}
