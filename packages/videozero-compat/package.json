{
  "name": "@videozero/compat",
  "version": "0.0.0",
  "private": true,
  "description": "VideoZero compatibility layer for Canvas Commons: the VideoZero text and layout animation shorthands and its defaults",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "VideoZero",
  "license": "MIT",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:pkg": "publint --strict && attw --pack . --profile esm-only --ignore-rules internal-resolution-error"
  },
  "sideEffects": false,
  "files": [
    "lib"
  ],
  "dependencies": {
    "@canvas-commons/2d": "workspace:^",
    "@canvas-commons/core": "workspace:^"
  },
  "devDependencies": {
    "geometry-polyfill": "^1.0.7",
    "jsdom": "catalog:",
    "vitest": "catalog:"
  }
}
