{
  "name": "@canvas-commons/d3-geo",
  "version": "0.4.0",
  "description": "Animated d3-geo maps for Canvas Commons",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "canvas-commons",
  "homepage": "https://canvascommons.io/",
  "bugs": "https://github.com/canvas-commons/canvas-commons/issues",
  "license": "MIT",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:pkg": "publint --strict && attw --pack . --profile esm-only --ignore-rules internal-resolution-error"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canvas-commons/canvas-commons.git",
    "directory": "packages/d3-geo"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "@canvas-commons/2d": "workspace:^",
    "@canvas-commons/core": "workspace:^",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-specification": "^1.0.5",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-simplify": "^3.0.3",
    "geometry-polyfill": "^1.0.7",
    "jsdom": "catalog:",
    "vitest": "catalog:"
  }
}
