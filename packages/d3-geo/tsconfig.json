{
  "compilerOptions": {
    "noImplicitAny": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "module": "esnext",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "declaration": true,
    "declarationMap": true,
    "experimentalDecorators": true,
    "resolveJsonModule": false,
    "jsx": "react-jsx",
    "jsxImportSource": "@canvas-commons/2d"
  },
  "include": ["src", "tsdown.config.ts", "vitest.config.ts"]
}
