{
  "compilerOptions": {
    "baseUrl": "src",
    "outDir": "lib",
    "inlineSourceMap": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "module": "ESNext",
    "target": "ES2020",
    "declaration": true,
    "declarationMap": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@motion-canvas/2d/src"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/testScene.ts"]
}
